{% extends "base.html.j2" %}
{% block body %}
<section>
  <h2>MSA report</h2>
  <div class="narrative">
    {% for line in narrative %}<p>{{ line }}</p>{% endfor %}
  </div>
  <table class="stats">
    <thead><tr><th>Statistic</th><th>Value</th><th>n</th><th>Window</th><th>Estimator</th></tr></thead>
    <tbody>
      {% for stat in statistics %}
      <tr>
        <td>{{ stat.label }}</td>
        <td>{{ stat.value }}</td>
        <td>{{ stat.n }}</td>
        <td>{{ stat.window_label }}</td>
        <td>{{ stat.estimator or "—" }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% if sections.get("judgement") %}
  <p>Judgement: {{ sections.judgement }}</p>
  {% endif %}
</section>
{% endblock %}
